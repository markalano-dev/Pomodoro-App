{
  "expo": {
    "name": "Pomocus",
    "slug": "pomocus",
    "scheme": "pomocus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#12131C"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alanodev.pomocus",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12131C"
      },
      "package": "com.alanodev.pomocus",
      "versionCode": 1,
      "permissions": [
        "VIBRATE"
      ]
    }
  }
}